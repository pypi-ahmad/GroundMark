    { "id": "raster_pages", "lane": "pipeline", "col": 1, "type": "backend", "label": "Preprocess", "sublabel": "hash & rasterize" },
    { "id": "visual_parse", "lane": "pipeline", "col": 3, "type": "cloud", "label": "Sol Parse", "sublabel": "gpt-6-sol visual", "tag": "Sequential" },
    { "id": "write_exports", "lane": "pipeline", "col": 5, "type": "backend", "label": "Export", "sublabel": "save files" },
