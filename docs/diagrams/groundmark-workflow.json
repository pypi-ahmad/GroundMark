  "cards": [
    {
      "dot": "emerald",
      "title": "Deterministic Pipeline",
      "items": [
        "LangGraph coordinates preprocess -> parse -> END workflow",
        "SHA-256 during preprocess; UTC basename during export",
        "Source order preserved with up to 12k preceding characters"
      ]
    },
    {
      "dot": "cyan",
      "title": "Multi-Format Artifacts",
      "items": [
        "Markdown, self-contained HTML, and schema_version: 2 JSON",
        "Annotated PDF with grounded bounding box overlays",
        "Clean vs Full views derived without re-calling models"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure Isolation",
      "items": [
        "Content filter diagnostics record HTTP 200 finish reasons",
        "Successful pages persist even if later pages fail",
        "No silent extraction correction or ungrounded rewriting"
      ]
    }
  ]
