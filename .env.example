# GroundMark
# Empty placeholders only. Never commit .env or real credentials.
# Configure only what you use; remove unused assignments before loading .env.
# Empty is not always equivalent to unset and can override working defaults/keys.
# groundmark loads .env in the current folder, or --env-file PATH.
# The UI's --workspace option changes its default .env folder.
# Existing environment variables take precedence.
# OPENAI_API_KEY is required. Leave REASONING_EFFORT unset for the code default.

OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional resource limits; values must be positive integers.
# GROUNDMARK_MAX_SOURCE_MIB=100
# GROUNDMARK_MAX_PAGES=250
# GROUNDMARK_MAX_IMAGE_PIXELS=50000000
# GROUNDMARK_MAX_PARSE_OUTPUT_TOKENS=16384
# Total expanded cells across all tables in one document.
# GROUNDMARK_MAX_TABLE_CELLS=10000
# GROUNDMARK_MAX_FIGURES=128
# GROUNDMARK_MAX_FIGURE_MIB=32
# Optional; omit to use medium reasoning.
# REASONING_EFFORT=medium
